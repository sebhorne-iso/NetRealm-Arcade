{
  "name": "netrealm-arcade",
  "version": "2.0.0",
  "description": "NetRealm Arcade: a library of retro study games for networking, DevOps and automation, with a central hub.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "new-game": "node tools/new-game.mjs",
    "validate": "node tools/validate-library.mjs",
    "test": "node --test \"tests/*.test.js\" \"games/*/tests/*.test.js\"",
    "check": "npm run validate && npm test"
  }
}
